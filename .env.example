# Copy to .env.production (and .env.staging) and fill in. Never commit real values.

# Public address of this instance, without a trailing slash.
APP_URL=https://whiskers.guitarcustom.shop
# Local port on the Mac (staging uses another one, e.g. 3001).
APP_PORT=3000
# Keep false on temporary domains: adds noindex and blocks robots.
ALLOW_INDEXING=false

# Database password (any long random string: `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# First superadmin, created on the first start if no user with this email exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Email for invitations and password resets (Resend). Without them links are only logged.
RESEND_API_KEY=
MAIL_FROM=Whiskers Club <noreply@guitarcustom.shop>

# Telegram bot for admin notifications (from @BotFather).
TELEGRAM_BOT_TOKEN=

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# Off-site encrypted backups (restic). Example for Backblaze B2 (S3 API):
#   RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/whiskers-backups/production
RESTIC_REPOSITORY=
# Encryption password. Store a copy outside the Mac: without it backups cannot be read.
RESTIC_PASSWORD=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_HOUR=3
DISK_WARN_PERCENT=85

# Wave 2 (AI); Ollama runs natively on the Mac.
AI_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
